#!/bin/sh
# Show slopstat usage as a desktop notification.
# Waybar tooltips are unreliable in 0.15.0, so the bar module calls this on click.
# --verbose prints the structured per-provider table. The notification daemon
# applies its 10 second default timeout.
exec notify-send --app-name=slopstat --transient \
	"Usage" "$(slopstat oneline --verbose 2>/dev/null | sed 's/ resets in / ↺/')"
