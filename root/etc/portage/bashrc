# Hack around https://bugs.gentoo.org/971849 which was breaking Rust and Niri
# (at a minimum... haven't tested the rest of my broken upgrades list yet)
# because system has LLVM 22 but Rust/Niri/etc. target LLVM slot 21. This might
# be especially acute because I use system-wide LLVM via
# /etc/portage/make.conf, but haven't dug too deep on that.
#
# I suspect, but don't know for sure, that the longer term fix for this would
# be in the upstream eclass somehow. llvm-r1 eclass (inherited by
# dev-lang/rust-1.93.0) says _LLVM_NEWEST_STABLE=21, which to me looks
# relevant, but I'm not really a Portage guru at the eclass/ebuild level.

if [[ -n "${LLVM_SLOT}" ]]; then
	_llvm_bin="/usr/lib/llvm/${LLVM_SLOT}/bin"

	# Move the matched LLVM slot to the FRONT of PATH so tools the build
	# invokes bare (notably llvm-profdata during CPython's PGO merge) resolve
	# to the same slot as the compiler below, rather than to a newer installed
	# slot. Each installed LLVM slot contributes an /etc/env.d/60llvm-* entry,
	# so ${_llvm_bin} is typically already somewhere in PATH (after the newer
	# slots); a prepend-only-if-absent would see it present and skip the fix.
	# Strip every existing occurrence first, then prepend, so the target slot
	# wins exactly once regardless of where env.d placed it.
	_llvm_path=":${PATH}:"
	_llvm_path=${_llvm_path//:${_llvm_bin}:/:}
	_llvm_path=${_llvm_path#:}
	_llvm_path=${_llvm_path%:}
	PATH="${_llvm_bin}:${_llvm_path}"
	unset _llvm_path

	if [[ "${CC}" == *clang* ]]; then
		CC="clang-${LLVM_SLOT}"
	fi

	if [[ "${CXX}" == *clang++* ]]; then
		CXX="clang++-${LLVM_SLOT}"
	fi

	if [[ "${AR}" == *llvm-ar* ]]; then
		AR="${_llvm_bin}/llvm-ar"
	fi

	if [[ "${NM}" == *llvm-nm* ]]; then
		NM="${_llvm_bin}/llvm-nm"
	fi

	if [[ "${RANLIB}" == *llvm-ranlib* ]]; then
		RANLIB="${_llvm_bin}/llvm-ranlib"
	fi

	export CC CXX AR NM RANLIB PATH
	unset _llvm_bin
fi
