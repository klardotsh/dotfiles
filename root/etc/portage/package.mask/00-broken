# Lock the dist-kernel to the 7.2.x series as a whole; no per-release names.
# ::gentoo dropped every 7.2.x ebuild, so an unlocked @world installs 6.18.63 (a
# stable downgrade) and then fails in prepare, because
# patches/sys-kernel/gentoo-kernel/0002-rate-limit-dmcub-diagnostics.patch targets
# dc_dmub_srv_handle_failure(), which does not exist in 6.18. Verified against the
# prepared 6.18.63 tree: 0001, 0003 and 0004 apply, 0002 fails.
# The next 7.2.x ebuild to land in the tree becomes selectable on its own.
# This also covers 6.18.33 and 6.18.33_p1, whose upstream sources changed size
# without regenerated manifests.
<sys-kernel/gentoo-kernel-7.2
>=sys-kernel/gentoo-kernel-7.3
<virtual/dist-kernel-7.2
>=virtual/dist-kernel-7.3

# upstream changed version number git tagging system to add a `v` prefix that the
# ebuild does not reflect; sources can't pull
>=app-editors/kakoune-lsp-21.0.0

# The ::4nykey wx split is broken at this version only. wxGTK-3.2.12 became a
# metadata wrapper that installs no /usr/lib64/wx/config script, so
# setup-wxwidgets cannot find gtk3-unicode-3.2 (media-sound/tenacity,
# media-video/mediainfo), and wxWidgets-3.2.12 fails to compile. Masking just
# these two falls back to the stable, self-contained ::gentoo wxGTK.
=x11-libs/wxGTK-3.2.12::4nykey
=x11-libs/wxWidgets-3.2.12::4nykey
