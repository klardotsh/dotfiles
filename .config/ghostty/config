#theme = light:GruvboxLightHard,dark:GruvboxDarkHard
#theme = light:Dawnfox,dark:Terafox
#theme = light:Selenized Light,dark:Selenized Black
#theme = light:Tomorrow,dark:Tomorrow Night Burns
#theme = light:Selenized Light,dark:ashen
#theme = light:Flexoki Light,dark:Flexoki Dark
#theme = light:Modus Operandi Tinted,dark:Modus Vivendi Tinted
#theme = light:iTerm2 Solarized Light,dark:iTerm2 Solarized Dark
theme = light:Kanso Pearl,dark:Kanso Zen

cursor-color = #d0a215
window-theme = system
minimum-contrast = 1.5

background-opacity = 0.915
background-blur = true

cursor-style = bar

# Updating ~/.config/fontconfig files does not sync with "monospace" here;
# fontconfig settings appear to be read once at application start and never
# again. Thus, specify the font explicitly so that (1) MacOS support is
# consistent, and (2) changing fonts gets picked up by Ctrl-Shift-Comma.
#font-family = Lilex
font-family = Cascadia Code
#font-family = Berkeley Mono
#font-family = CommitMono
#font-family = Fira Code
#font-family = Maple Mono
#font-family = PragmataPro Liga
#font-family = Iosevka Term
#font-family = Twitter Color Emoji
#font-family = FSD Emoji
font-size = 14

# We always want these.
font-feature = +calt,+liga

# Individual font overrides could go below. For example, for Maple Mono, we'd
# want (to match my old Wezterm config):
#font-feature = +dlig,+cv01,+cv35,+ss02,+ss03,+ss04,+ss05,-ss06,+ss01

# Iosevka
# ss08: PragmataPro style. ss14: JetBrains Mono style. ss15: IBM Plex Mono style.
#font-feature = +dlig,+ss08,VSAH=3,VLAA=1,VLAC=1,VLAD=1

# Lilex
#font-feature = +dlig,+zero,+cv14,+cv13,+cv06,+cv15,+cv11,+cv08

# Commit Mono:
# ss01: more ligatures, eg. ===
# ss02: arrows
# ss03: uppercase symbols adjacent to uppercase letters
# ss04: 2-/3-character spacing shrinkage
# ss05: smart kerning (I think)
# cv03: squarish dots for eg. punctuation
# cv07: zero selection (negate is slashed)
# cv09: asterisk selection (negate is inline)
#font-feature = +dlig,+ss01,+ss02,+ss03,+ss04,+ss05,+cv03,-cv07,-cv09

working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = true
split-inherit-working-directory = true
